       interrupts = <0x14>;
       reg = <0x0 0x13000 0x0 0x1000>;
       reg-names = "control";
@@ -105,14 +108,14 @@
         spi-max-frequency = <1000000>;
         voltage-ranges = <3300 3300>;
         disable-wp;
-        // gpios = <&gpio0 6 1>;
