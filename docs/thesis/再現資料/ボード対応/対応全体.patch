+    .HMASTLOCK(), .HREADY, .TIMECLK(1'b0), .GPIOIN, .GPIOOUT, .GPIOEN(),
+    .UARTSin(BoardInputSync[9]), .UARTSout, .SPIIn(1'b1), .SPIOut(), .SPICS(), .SPICLK(),
+    .SDCIn, .SDCCmd, .SDCCS(SDCCSAll), .SDCCLK, .PWMGPIO());
+
