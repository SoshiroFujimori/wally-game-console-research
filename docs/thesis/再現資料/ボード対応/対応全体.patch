+  logic [31:0]  DDRAXIAWADDR;
+  logic [7:0]   DDRAXIAWLEN;
+  logic [2:0]   DDRAXIAWSIZE;
+  logic [1:0]   DDRAXIAWBURST;
+  logic         DDRAXIAWLOCK;
+  logic [3:0]   DDRAXIAWCACHE;
+  logic [2:0]   DDRAXIAWPROT;
+  logic         DDRAXIAWVALID;
+  logic         DDRAXIAWREADY;
+  logic [63:0]  DDRAXIWDATA;
+  logic [7:0]   DDRAXIWSTRB;
+  logic         DDRAXIWLAST;
