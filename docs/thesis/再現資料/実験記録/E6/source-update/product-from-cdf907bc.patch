-.equ low_ie, (GPIO+0x30)
-.equ low_ip, (GPIO+0x34)
-.equ iof_en, (GPIO+0x38)
-.equ iof_sel, (GPIO+0x3C)
-.equ out_xor, (GPIO+0x40)
